# --- Secrets & environment (never commit real values) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Dependencies ---
node_modules
.pnp
.pnp.js

# --- Build output ---
dist
dist-ssr
build
*.tsbuildinfo

# --- Convex generated files ---
# The generated client API is intentionally committed: Vercel type-checks the
# project on a clean clone before any codegen can run, so the real files must be
# in the repo. Regenerate instead of hand-editing:
#   npx convex codegen   (or: npx convex dev --once)

# --- Logs ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*

# --- Test / coverage ---
coverage
.nyc_output

# --- Editor & OS junk ---
.DS_Store
Thumbs.db
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# --- Editors ---
.vscode/*
!.vscode/extensions.json
.idea

# --- Tauri desktop build ---
src-tauri/target
src-tauri/gen
src-tauri/icons/android
src-tauri/icons/ios

# --- Offline database (local only, never part of the source) ---
*.db
*.db-shm
*.db-wal
